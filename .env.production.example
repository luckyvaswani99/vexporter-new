# VEXPORTER — production environment template
# Copy to .env on the server, fill in the real values, then run:
#   php artisan key:generate && php artisan vexporter:preflight --strict

APP_NAME=VEXPORTER
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vexporter.com
APP_TIMEZONE=Asia/Kolkata

# Never leave these on in production.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# --- Database ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vexporter
DB_USERNAME=forge
DB_PASSWORD=

# --- Cache, queue & session -------------------------------------------------
# Redis is required: the cart, session and queue all depend on it under load.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Filesystem -------------------------------------------------------------
# Public assets on S3/R2 + CDN; KYC and COA paperwork stays on the private disk.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=vexporter-public
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@vexporter.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Marketplace ------------------------------------------------------------
PLATFORM_COMMISSION_PERCENT=5
DEFAULT_CURRENCY=USD
VEXPORTER_PHONE="+91 98765 43210"
VEXPORTER_EMAIL=support@vexporter.com

# --- Payment gateways -------------------------------------------------------
# Read through config/services.php so `config:cache` cannot blank them out.
DEFAULT_PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Search (Phase 8 follow-up) ---------------------------------------------
SCOUT_DRIVER=database
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# --- Monitoring -------------------------------------------------------------
SENTRY_LARAVEL_DSN=
