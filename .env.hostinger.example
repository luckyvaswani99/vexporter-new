# VEXPORTER — Hostinger shared hosting (Business plan and above)
#
# Copy to .env on the server over SSH, fill in the blanks, then:
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan optimize
#   php artisan vexporter:preflight
#
# Differences from .env.production.example: no Redis and no S3, because shared
# hosting gives you neither. Everything runs off MySQL and local disk.

APP_NAME=VEXPORTER
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# --- Database -----------------------------------------------------------------
# hPanel → Databases → MySQL Databases. Hostinger prefixes both the database
# and the user with your account id, e.g. u673430861_vexporter.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Cache, queue & session ---------------------------------------------------
# No Redis on shared hosting. The scheduler drains the database queue every
# minute (see routes/console.php), so QUEUE_CONNECTION must stay `database`.
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Filesystem ---------------------------------------------------------------
# Local disk. Run `php artisan storage:link` once after the first deploy.
FILESYSTEM_DISK=public

# --- Mail ---------------------------------------------------------------------
# hPanel → Emails → Email Accounts, then use those SMTP details here.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Marketplace --------------------------------------------------------------
PLATFORM_COMMISSION_PERCENT=5
DEFAULT_CURRENCY=USD
VEXPORTER_PHONE="+91 98765 43210"
VEXPORTER_EMAIL=support@your-domain.com

# --- Payment gateways ---------------------------------------------------------
# Leave blank to keep a gateway switched off in Admin → Finance → Payment
# methods. Placeholder values are rejected by preflight in production.
DEFAULT_PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Search -------------------------------------------------------------------
SCOUT_DRIVER=database

# --- Monitoring ---------------------------------------------------------------
SENTRY_LARAVEL_DSN=
